# PostgreSQL container settings (used by docker compose)
POSTGRES_USER=letterbox
POSTGRES_PASSWORD=letterbox
POSTGRES_DB=letterbox
POSTGRES_PORT=5433

# Application connection string (used when running the Go server locally)
DATABASE_URL=postgres://letterbox:letterbox@localhost:5433/letterbox?sslmode=disable

# Valkey cache (used by docker compose and the Go server locally)
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_USE_TLS=false
VALKEY_DATABASE_ID=0

# HTTP server
PORT=8080

# Use "production" to mark the session cookie as Secure
APP_ENV=development
TMDB_API_KEY=your_tmdb_api_key_here

CLIENT_ID_GOOGLE_OAUTH=your_google_oauth_client_id_here
CLIENT_SECRET_GOOGLE_OAUTH=your_google_oauth_client_secret_here
# Public callback URL registered in Google Cloud Console. When empty it defaults
# to http://localhost:$PORT/api/v1/auth/oauth2/google/callback.
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth2/google/callback

